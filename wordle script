local function getParts()
    local ui = playerGui:FindFirstChild("WordGameUI")
    local canvas = ui and ui:FindFirstChild("Canvas")
    local match = canvas and canvas:FindFirstChild("Match")
    if not match then return end

    local box = match:FindFirstChild("TypingCapture")
    local tiles = match:FindFirstChild("WordTiles")
    local first = tiles and tiles:FindFirstChild("Letter1")
    local glyph = first and first:FindFirstChild("Glyph")
    local feedback = match:FindFirstChild("Feedback")

    if box and box:IsA("TextBox")
        and glyph and glyph:IsA("TextLabel") then
        return box, glyph, feedback
    end
end

local function getLetter(glyph)
    local text = glyph.Text:match("^%s*(.-)%s*$")
    return lowerToUpper[text] or text
end

-- Единственная функция выбора: самое КОРОТКОЕ неиспользованное слово.
local function shortestUnused(letter)
    local list = words[letter]
    if not list then return nil end

    local best = nil
    local bestLen = math.huge
    for _, word in ipairs(list) do
        if not used[word] then
            local len = utf8.len(word) or #word
            if len < bestLen then
                bestLen = len
                best = word
            end
        end
    end
    return best
end

local nextWord = shortestUnused

-- ============================================================
-- ИСПРАВЛЕНО: typeAndSubmit
--   • submitted = false перед новым набором
--   • ReleaseFocus → пауза → CaptureFocus перед Enter
--   • watchdog на 4с с отменой по generation
-- ============================================================
local function typeAndSubmit(box, glyph, letter, word, label)
    local secondByte = utf8.offset(word, 2)
    if not secondByte then
        submitted = true
        status.Text = "Ошибка слова в словаре."
        return
    end

    local rest = word:sub(secondByte)

    -- ИСПРАВЛЕНО: сброс залипшего флага
    submitted = false

    used[word] = true
    lastWord = word
    submitted = true
    local myGen = generation

    status.Text = label .. ": " .. word
        .. "\nРежим: " .. (MODE_LABELS[mode] or "?")
        .. "\nОжидаю ответ игры."

    if mode == "human" then
        sleep(HUMAN.preTypeDelay[1], HUMAN.preTypeDelay[2])
    elseif mode == "medium" then
        sleep(HUMAN.mediumPreDelay[1], HUMAN.mediumPreDelay[2])
    end

    -- ИСПРАВЛЕНО: гарантированный фокус перед набором
    pcall(function()
        box:ReleaseFocus()
        task.wait(0.05)
        box:CaptureFocus()
    end)

    if mode == "human" then
        sleep(0.06, 0.22)
    end

    clearBox(box)

    if mode == "human" then
        sleep(HUMAN.afterClear[1], HUMAN.afterClear[2])
    elseif mode == "medium" then
        sleep(HUMAN.mediumAfterClear[1], HUMAN.mediumAfterClear[2])
    end

    local allowed = buildAllowedCodes(letter)
    if not humanType(box, rest, allowed) then
        pcall(function() box.Text = rest end)
    end

    -- ИСПРАВЛЕНО: перефокусировка прямо перед Enter
    pcall(function()
        box:ReleaseFocus()
        task.wait(0.03)
        box:CaptureFocus()
    end)

    -- Enter
    if hasEnterAPI() then
        local pressed = pcall(keypress, 0x0D)
        task.wait(randFloat(0.03, 0.07))
        local released = pcall(keyrelease, 0x0D)

        if not pressed or not released then
            pcall(function() box:ReleaseFocus() end)
        end
    else
        pcall(function() box:ReleaseFocus() end)
    end

    -- ИСПРАВЛЕНО: watchdog — если Feedback не пришёл за 4с
    task.delay(4.0, function()
        if generation ~= myGen then return end
        if not submitted then return end
        if not running or not enabled then return end
        -- принудительный сброс
        submitted = false
        local b = select(1, getParts())
        if b then clearBox(b) end
        task.delay(retryDelayByMode(), function()
            if generation ~= myGen then return end
            if not running or not enabled then return end
            if submitted then return end
            attemptShortest()
        end)
    end)
end

-- ============================================================
-- ИСПРАВЛЕНО: attempt / attemptShortest
--   • submitted = false перед новым набором
-- ============================================================
local function attempt()
    if not running or not enabled then return end
    submitted = false

    local box, glyph = getParts()
    if not box or UserInputService:GetFocusedTextBox() ~= box then
        status.Text = "Жду твоего хода и фокуса поля."
        return
    end

    if not hasEnterAPI() then
        enabled = false
        generation += 1
        updateButtons()
        status.Text = "Executor не поддерживает keypress/keyrelease."
        return
    end

    local letter = getLetter(glyph)
    local word = nextWord(letter)

    if not word then
        submitted = true
        status.Text = "Нет слов на «" .. tostring(letter)
            .. "».\nВ новом раунде нажми «Сбросить слова»."
        return
    end

    typeAndSubmit(box, glyph, letter, word, "Пробую")
end

local function attemptShortest()
    if not running or not enabled then return end
    submitted = false

    local box, glyph = getParts()
    if not box or UserInputService:GetFocusedTextBox() ~= box then
        status.Text = "Жду твоего хода и фокуса поля."
        return
    end

    if not hasEnterAPI() then
        enabled = false
        generation += 1
        updateButtons()
        status.Text = "Executor не поддерживает keypress/keyrelease."
        return
    end

    local letter = getLetter(glyph)
    local word = shortestUnused(letter)

    if not word then
        submitted = true
        status.Text = "Нет коротких слов на «" .. tostring(letter)
            .. "».\nНажми «Сбросить слова»."
        return
    end

    typeAndSubmit(box, glyph, letter, word, "Отклонено. Пишу короткое")
end

local function retryDelayByMode()
    if mode == "human" then
        return randFloat(HUMAN.retryDelay[1], HUMAN.retryDelay[2])
    elseif mode == "medium" then
        return randFloat(HUMAN.mediumRetryDelay[1], HUMAN.mediumRetryDelay[2])
    end
    return randFloat(HUMAN.instantRetryDelay[1], HUMAN.instantRetryDelay[2])
end

-- ============================================================
-- ИСПРАВЛЕНО: bindFeedback / check
--   • Подписка и на Visible, и на Text
--   • Дедупликация через lastFeedbackText / lastFeedbackVisible
--   • submitted = false ДО любых проверок
--   • if not running or not enabled then return end перед attemptShortest
-- ============================================================
local function bindFeedback(feedback)
    if feedbackConnection then
        feedbackConnection:Disconnect()
        feedbackConnection = nil
    end

    if not feedback or not feedback:IsA("TextLabel") then return end

    local function check()
        if not feedback then return end
        if not running or not enabled then return end

        local curVis = feedback.Visible
        local curTxt = feedback.Text or ""

        -- ИСПРАВЛЕНО: дедупликация
        if curVis == lastFeedbackVisible and curTxt == lastFeedbackText then
            return
        end
        lastFeedbackVisible = curVis
        lastFeedbackText = curTxt

        if not curVis then return end
        if not curTxt:find("не подходит", 1, true) then return end

        -- ИСПРАВЛЕНО: сброс флага ДО проверки submitted
        submitted = false
        local token = generation
        status.Text = "Отклонено: " .. tostring(lastWord)
            .. ". Стираю и пишу короткое..."

        task.delay(retryDelayByMode(), function()
            if not running or not enabled then return end   -- ИСПРАВЛЕНО
            if generation == token and not submitted then
                attemptShortest()
            end
        end)
    end

    -- ИСПРАВЛЕНО: два сигнала
    local c1 = feedback:GetPropertyChangedSignal("Visible"):Connect(check)
    local c2 = feedback:GetPropertyChangedSignal("Text"):Connect(check)
    table.insert(connections, c1)
    table.insert(connections, c2)
    feedbackConnection = c1
end

local function turnOn()
    if enabled or not running then return end

    if not hasEnterAPI() then
        status.Text = "Executor не поддерживает keypress/keyrelease."
        return
    end

    generation += 1
