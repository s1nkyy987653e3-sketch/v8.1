-- Вставляется в самый конец скрипта.
-- ============================================================
do
    if _G.__P_WordBot_ErrorLog then
        pcall(function() _G.__P_WordBot_ErrorLog:Destroy() end)
        _G.__P_WordBot_ErrorLog = nil
    end

    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local botGui = playerGui:FindFirstChild("P_WordBot")
    if not botGui then
        warn("[WordBot] Главный GUI P_WordBot не найден — логгер не запущен.")
        return
    end

    -- ===== Хранилища =====
    local wrongEntries = {}     -- {key, letter, word, reasonList, feedbackList, time}
    local seenWrong = {}

    local opponentEntries = {}
    local seenOpponent = {}

    local lastSent = nil        -- {letter, word}

    local skippedUsed = 0       -- сколько раз сработало «уже было»

    -- ===== Причины, которые ИГНОРИРУЕМ полностью =====
    local function isIgnoredReason(text)
        if not text or text == "" then return false end
        local t = text:lower()
        if t:find("уже", 1, true) then return true end
        if t:find("было", 1, true) then return true end
        if t:find("использован", 1, true) then return true end
        if t:find("повтор", 1, true) then return true end
        if t:find("раньше", 1, true) then return true end
        return false
    end

    -- ===== Классификация причины =====
    local function classifyFeedback(text)
        if not text or text == "" then return "неизвестно" end
        local t = text:lower()

        if t:find("проверяем", 1, true) then return "проверяется" end
        if t:find("не подходит", 1, true) then return "не подходит" end
        if t:find("неверн", 1, true) then return "неверная буква" end
        if t:find("коротк", 1, true) then return "слишком короткое" end
        if t:find("длинн", 1, true) then return "слишком длинное" end
        if t:find("нет слова", 1, true) then return "нет в словаре игры" end
        if t:find("не найдено", 1, true) then return "нет в словаре игры" end
        if t:find("время", 1, true) or t:find("вышло", 1, true) then
            return "время вышло"
        end
        if t:find("нельзя", 1, true) then return "нельзя" end
        if t:find("ошибк", 1, true) then return "ошибка" end

        return "иное: " .. text:sub(1, 40)
    end

    -- ===== Утилиты поиска =====
    local function getMatch()
        local ui = playerGui:FindFirstChild("WordGameUI")
        local canvas = ui and ui:FindFirstChild("Canvas")
        return canvas and canvas:FindFirstChild("Match")
    end

    local function currentLetterAndWord()
        local match = getMatch()
        if not match then return nil, nil end

        local tiles = match:FindFirstChild("WordTiles")
        local first = tiles and tiles:FindFirstChild("Letter1")
        local glyph = first and first:FindFirstChild("Glyph")
        local box = match:FindFirstChild("TypingCapture")

        local letter = nil
        if glyph and glyph:IsA("TextLabel") then
            local raw = glyph.Text:match("^%s*(.-)%s*$")
            if raw ~= "" then letter = raw end
        end

        local word = nil
        if box and box:IsA("TextBox") and box.Text ~= "" then
            if letter then
                word = letter .. box.Text
            else
                word = box.Text
            end
        end

        return letter, word
    end

    -- ===== Перехват Enter для запоминания отправленного слова =====
    local originalKeypress = keypress
    if type(originalKeypress) == "function" then
        keypress = function(code, ...)
            if code == 0x0D then
                local letter, word = currentLetterAndWord()
                if word and word ~= "" then
                    lastSent = { letter = letter, word = word }
                end
            end
            return originalKeypress(code, ...)
        end
    end

    -- ===== Запись ошибки (с фильтром «уже было») =====
    local function recordWrong(letter, word, feedbackText)
        if not word or word == "" then return end

        if isIgnoredReason(feedbackText) then
            skippedUsed += 1
            updateCounts()
            return
        end

        local reason = classifyFeedback(feedbackText)

        if reason == "проверяется" then return end

        local key = tostring(letter) .. "|" .. tostring(word)

        for _, e in ipairs(wrongEntries) do
            if e.key == key then
                if not e.reasons[reason] then
                    e.reasons[reason] = true
                    e.reasonList = e.reasonList .. "; " .. reason
                end
                e.feedbackList = (e.feedbackList ~= "" and
                    (e.feedbackList .. " | " .. (feedbackText or "")))
                    or (feedbackText or "")
                refreshList()
                return
            end
        end

        seenWrong[key] = true
        table.insert(wrongEntries, {
            key = key,
            letter = letter or "?",
            word = word,
            reasons = { [reason] = true },
            reasonList = reason,
            feedbackList = feedbackText or "",
            time = os.date("%H:%M:%S"),
        })
        refreshList()
    end

    -- ===== Запись слова противника =====
    local function recordOpponent(name, word, source)
        if not word or word == "" then return end
        local clean = word:match("^%s*(.-)%s*$")
        if clean == "" or #clean > 40 then return end
        if clean:find("%s") then return end
        if clean:match("^%d+$") then return end

        local key = (name or "?") .. "|" .. clean
        if seenOpponent[key] then return end
        seenOpponent[key] = true

        table.insert(opponentEntries, {
            name = name or "?",
            word = clean,
            source = source or "",
            time = os.date("%H:%M:%S"),
        })
        refreshList()
    end

    local function looksLikeOpponentWord(text)
        if not text or text == "" then return false end
        local t = text:match("^%s*(.-)%s*$")
        if t == "" or #t > 40 then return false end
        if t:find("%s") then return false end
        if t:match("^%d+$") then return false end
        if not t:find("%a") and not t:find("[а-яА-Я]") then return false end
        return true
    end

    local function isOpponentElement(label)
        local n = (label.Name or ""):lower()
        local p = (label.Parent and label.Parent.Name or ""):lower()
        if n == "glyph" then return false end
        if p == "wordtiles" then return false end
        if n:find("opponent") or n:find("enemy") or n:find("rival") then
            return true
        end
        if n:find("history") or n:find("log") or n:find("feed") then
            return true
        end
        if p:find("history") or p:find("log") or p:find("feed")
            or p:find("opponent") or p:find("moves")
        then
            return true
        end
        return false
    end

    local function scanKnownContainers()
        local match = getMatch()
        if not match then return end

        local names = {
            "History", "Log", "Feed", "Moves",
            "OpponentWord", "OpponentMoves", "EnemyWords",
        }

        local function scan(root, source)
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    if looksLikeOpponentWord(d.Text) then
                        local name = d.Parent and d.Parent.Name or d.Name
                        recordOpponent(name, d.Text, source)
                    end
                end
            end
        end

        for _, cn in ipairs(names) do
            local c = match:FindFirstChild(cn)
            if c then scan(c, "container:" .. cn) end
        end
    end

    local function bindOpponentWatcher()
        local match = getMatch()
        if not match then return end
        for _, d in ipairs(match:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton"))
                and isOpponentElement(d)
                and not d:GetAttribute("__wb_bound")
            then
                d:SetAttribute("__wb_bound", true)
                d:GetPropertyChangedSignal("Text"):Connect(function()
                    if looksLikeOpponentWord(d.Text) then
                        local name = d.Parent and d.Parent.Name or d.Name
                        recordOpponent(name, d.Text, "watcher")
                    end
                end)
                if looksLikeOpponentWord(d.Text) then
                    local name = d.Parent and d.Parent.Name or d.Name
                    recordOpponent(name, d.Text, "watcher-initial")
                end
            end
        end
    end

    -- ===== Feedback: слушаем и Visible, и Text =====
    local feedbackConns = {}
    local boundFeedback

    local function checkFeedback(feedback)
        if not feedback or not feedback:IsA("TextLabel") then return end

        local txt = feedback.Text or ""
        if txt == "" then return end

        local lowerTxt = txt:lower()

        if lowerTxt:find("проверяем", 1, true) then return end

        if isIgnoredReason(txt) then
            if lastSent then
                skippedUsed += 1
                lastSent = nil
                updateCounts()
            end
            return
        end

        local isError =
            lowerTxt:find("не подходит", 1, true)
            or lowerTxt:find("неверн", 1, true)
            or lowerTxt:find("ошибк", 1, true)
            or lowerTxt:find("нельзя", 1, true)
            or lowerTxt:find("не найдено", 1, true)
            or lowerTxt:find("нет слова", 1, true)
            or lowerTxt:find("коротк", 1, true)
            or lowerTxt:find("длинн", 1, true)
            or lowerTxt:find("время", 1, true)
            or lowerTxt:find("вышло", 1, true)

        if not isError then return end

        if lastSent then
            recordWrong(lastSent.letter, lastSent.word, txt)
            lastSent = nil
        else
            local letter, word = currentLetterAndWord()
            recordWrong(letter, word, txt)
        end
    end

    local function bindFeedbackWatcher()
        local match = getMatch()
        local feedback = match and match:FindFirstChild("Feedback")

        if feedback ~= boundFeedback then
            for _, c in ipairs(feedbackConns) do
                pcall(function() c:Disconnect() end)
            end
            feedbackConns = {}
            boundFeedback = feedback

            if feedback and feedback:IsA("TextLabel") then
                local c1 = feedback:GetPropertyChangedSignal("Visible"):Connect(function()
                    checkFeedback(feedback)
                end)
                local c2 = feedback:GetPropertyChangedSignal("Text"):Connect(function()
                    checkFeedback(feedback)
                end)
                table.insert(feedbackConns, c1)
                table.insert(feedbackConns, c2)
            end
        end
    end

