    local boundFeedback

    while running do
        local box, _, feedback = getParts()

        if feedback ~= boundFeedback then
            boundFeedback = feedback
            bindFeedback(feedback)
        end

        if enabled then
            local focused = box ~= nil
                and UserInputService:GetFocusedTextBox() == box

            if focused and not previousFocus then
                submitted = false
                local token = generation

                if mode == "human" then
                    sleep(HUMAN.focusDelay[1], HUMAN.focusDelay[2])
                end

                if running and enabled and generation == token and not submitted then
                    attempt()
                end
            elseif not focused and previousFocus then
                submitted = false
                status.Text = "Жду следующего хода."
            end

            previousFocus = focused
        else
            previousFocus = false
        end

        task.wait(0.1)
    end
end)

