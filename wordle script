    submitted = false
    previousFocus = false
    updateButtons()
    status.Text = "ВКЛ. Режим: " .. (MODE_LABELS[mode] or "?")
        .. "\nСписок использованных слов сохранён."
end

local function pause()
    generation += 1
    enabled = false
    submitted = false
    updateButtons()
    status.Text = "ПАУЗА. Использованные слова сохранены."
end

local function resetWords()
    generation += 1
    table.clear(used)
    lastWord = nil

    local box = getParts()
    if enabled and box and UserInputService:GetFocusedTextBox() == box then
        submitted = false
        local token = generation
        status.Text = "Список сброшен. Пробую слово..."

        task.delay(randFloat(0.2, 0.6), function()
            if running and enabled and generation == token and not submitted then
                attempt()
            end
        end)
    else
        submitted = false
        status.Text = "Список слов сброшен. Жду следующий ход."
    end
end

