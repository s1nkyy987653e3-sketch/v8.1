local function stop()
    if not running then return end

    generation += 1
    enabled = false
    running = false

    if type(keyrelease) == "function" then
        pcall(keyrelease, 0x0D)
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()
end

