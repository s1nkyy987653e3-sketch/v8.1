local rng = Random.new(os.clock() * 1000)

local function randFloat(minV, maxV)
    return minV + rng:NextNumber() * (maxV - minV)
end

local function randInt(minV, maxV)
    return rng:NextInteger(minV, maxV)
end

local function sleep(minV, maxV)
    task.wait(randFloat(minV, maxV))
end

local function hasEnterAPI()
    return type(keypress) == "function" and type(keyrelease) == "function"
end

local function buildAllowedCodes(letter)
    local list = words and words[letter]
    if not list then return nil end
    local allowed, seen = {}, {}
    for _, w in ipairs(list) do
        local second = utf8.offset(w, 2)
        if second then
            local firstChar = w:sub(1, second - 1)
            if firstChar ~= "" and not seen[firstChar] then
                seen[firstChar] = true
                local ok, cp = pcall(utf8.codepoint, firstChar)
                if ok and cp then table.insert(allowed, cp) end
            end
        end
    end
    if #allowed == 0 then return nil end
    return allowed
end

local function dropLastChar(text)
    if text == "" then return text end
    local lastStart = utf8.offset(text, -1)
    if not lastStart then return "" end
    return text:sub(1, lastStart - 1)
end

local function ensureChar(box, char)
    for _ = 1, 2 do
        local current = box.Text
        if current:sub(-#char) == char then
            return true
        end
        local ok = pcall(function()
            box.Text = box.Text .. char
        end)
        if not ok then return false end
        task.wait(0.01)
    end
    return box.Text:sub(-#char) == char
end

-- ============================================================
-- ИСПРАВЛЕНО: clearBox
--   • Вся посимвольная очистка обёрнута в один pcall
--   • В конце гарантированно box.Text = "" (страховка)
-- ============================================================
local function clearBox(box)
    if not box then return end
    if box.Text == "" then return end

    if mode ~= "human" then
        pcall(function() box.Text = "" end)
        return
    end

    local length = utf8.len(box.Text) or 0
    if length == 0 then
        pcall(function() box.Text = "" end)
        return
    end

    local clearMood = randFloat(0.7, 1.4)

    -- ИСПРАВЛЕНО: весь цикл в одном pcall
    pcall(function()
        for _ = 1, length do
            box.Text = dropLastChar(box.Text)
            sleep(
                HUMAN.clearCharDelay[1] * clearMood,
                HUMAN.clearCharDelay[2] * clearMood
            )
        end
    end)

    -- ИСПРАВЛЕНО: страховка — поле гарантированно пустое
    pcall(function() box.Text = "" end)
end

local function humanMaybeTypo(box, allowed, typoChance)
    if not allowed or rng:NextNumber() >= typoChance then
        return
    end
    local wrong = allowed[rng:NextInteger(1, #allowed)]
    if not wrong then return end

    local wrongChar = utf8.char(wrong)
    local before = box.Text

    local ok = pcall(function()
        box.Text = before .. wrongChar
    end)
    if not ok then return end

    if box.Text:sub(-#wrongChar) ~= wrongChar then
        return
    end

    sleep(HUMAN.typoFixDelay[1], HUMAN.typoFixDelay[2])

    pcall(function()
        if box.Text:sub(-#wrongChar) == wrongChar then
            box.Text = box.Text:sub(1, -#wrongChar - 1)
        end
    end)

    sleep(0.03, 0.15)
end

-- ============================================================
-- ИСПРАВЛЕНО: humanTypeHuman
--   • При backspaceCount = 0 и burstPhase "normal" после burst
--     гарантированный выход из continue (burstDone сбрасывается)
-- ============================================================
local function humanTypeHuman(box, text, allowed)
    local speedMood = randFloat(HUMAN.speedMoodMin, HUMAN.speedMoodMax)
    local typoChance = randFloat(HUMAN.typoChanceMin, HUMAN.typoChanceMax)

    local chars = {}
    for _, code in utf8.codes(text) do
        table.insert(chars, utf8.char(code))
    end

    local totalLen = #chars
    if totalLen == 0 then return true end

    local stallAt = nil
    if rng:NextNumber() < HUMAN.stallChance and totalLen > 1 then
        stallAt = randInt(2, totalLen)
    end

    local burstEnabled = totalLen >= 8 and rng:NextNumber() < HUMAN.burstChance
    local burstStopAt = nil
    if burstEnabled then
        burstStopAt = randInt(
            math.max(2, math.floor(totalLen * 0.35)),
            math.max(2, math.floor(totalLen * 0.75))
        )
        if burstStopAt >= totalLen then
            burstStopAt = totalLen - 1
        end
    end
    local burstDone = false
    local burstPhase = burstEnabled and "fast" or "normal"

    local typedCount = 0

    while typedCount < totalLen do
        local nextIndex = typedCount + 1

        if burstPhase == "fast"
            and not burstDone
            and nextIndex >= (burstStopAt or math.huge)
        then
            burstDone = true
            sleep(HUMAN.burstStopDelay[1], HUMAN.burstStopDelay[2])

            local backspaceCount = randInt(
                HUMAN.burstBackspace[1], HUMAN.burstBackspace[2]
            )
            if backspaceCount > typedCount then
                backspaceCount = typedCount
            end
            if backspaceCount < 0 then backspaceCount = 0 end

            for _ = 1, backspaceCount do
                local ok = pcall(function()
                    if box.Text ~= "" then
                        box.Text = dropLastChar(box.Text)
                    end
                end)
                if not ok then break end
                typedCount = math.max(0, typedCount - 1)
                sleep(0.04, 0.14)
            end

            sleep(0.10, 0.35)
            burstPhase = "normal"
            -- ИСПРАВЛЕНО: burstDone сбрасываем, чтобы не зациклиться
            burstDone = false
            speedMood = randFloat(HUMAN.speedMoodMin, HUMAN.speedMoodMax)

            -- ИСПРАВЛЕНО: если backspaceCount = 0 и typedCount не изменился,
            -- просто продолжаем — continue больше не ведёт в пустой цикл,
            -- потому что burstDone = false, а burstPhase = "normal"
            continue
        end

        humanMaybeTypo(box, allowed, typoChance)

        local char = chars[nextIndex]
        if not ensureChar(box, char) then
            return false
        end

        typedCount = nextIndex

        local delay
        if burstPhase == "fast" then
            delay = randFloat(
                HUMAN.minCharDelay * HUMAN.burstFastMultiplier,
                HUMAN.maxCharDelay * HUMAN.burstFastMultiplier
            )
        else
            delay = randFloat(
                HUMAN.minCharDelay * speedMood,
                HUMAN.maxCharDelay * speedMood
            )
        end

        if stallAt == typedCount then
            delay += randFloat(HUMAN.stallExtra[1], HUMAN.stallExtra[2])
        end

        task.wait(delay)
    end

    return box.Text:sub(-#text) == text
end

-- Средний набор: посимвольно, без опечаток/burst/залипаний, ровные короткие паузы
local function humanTypeMedium(box, text)
    for _, code in utf8.codes(text) do
        local char = utf8.char(code)
        if not ensureChar(box, char) then
            return false
        end
        sleep(HUMAN.mediumCharDelay[1], HUMAN.mediumCharDelay[2])
    end
    return box.Text:sub(-#text) == text
end

-- Мгновенный набор: вставляем всё слово сразу
local function humanTypeInstant(box, text)
    local ok = pcall(function()
        box.Text = text
    end)
    if not ok then return false end
    return box.Text:sub(-#text) == text
end

-- Универсальная точка входа
local function humanType(box, text, allowed)
    if mode == "instant" then
        return humanTypeInstant(box, text)
    elseif mode == "medium" then
        return humanTypeMedium(box, text)
    end
    return humanTypeHuman(box, text, allowed)
end

local function sortByLengthDesc(list)
    table.sort(list, function(a, b)
        local la = utf8.len(a) or #a
        local lb = utf8.len(b) or #b
        if la ~= lb then
            return la > lb
        end
        return a < b
    end)
    return list
end

