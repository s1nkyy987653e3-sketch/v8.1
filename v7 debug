local P = game:GetService("Players")
local W = game:GetService("Workspace")
local LP = P.LocalPlayer

print("=== [v13] Запущен | " .. os.date("%H:%M:%S") .. " ===")

-- 1. Точные пути к Ring/RingIn/GAS_1/gas_2/HW_RING (раз в 5 сек)
task.spawn(function()
    while task.wait(5) do
        local names = {"Ring", "RingIn", "GAS_1", "gas_2", "HW_RING"}
        print("[FIND]")
        for _, obj in ipairs(W:GetDescendants()) do
            for _, n in ipairs(names) do
                if obj.Name == n then
                    local pos = Vector3.zero
                    local size = Vector3.zero
                    if obj:IsA("BasePart") then
                        pos = obj.Position
                        size = obj.Size
                    elseif obj:IsA("Model") then
                        local ok, p = pcall(function() return obj:GetPivot().Position end)
                        if ok then pos = p end
                    end
                    print(string.format("  %s | %s | pos=(%.1f,%.1f,%.1f) | size=(%.1f,%.1f,%.1f) | path=%s",
                        obj.ClassName, obj.Name,
                        pos.X, pos.Y, pos.Z,
                        size.X, size.Y, size.Z,
                        obj:GetFullName()))
                end
            end
        end
    end
end)

-- 2. Все персонажи через GetDescendants (раз в 5 сек)
task.spawn(function()
    while task.wait(5) do
        print("[CHARS]")
        local found = 0
        for _, obj in ipairs(W:GetDescendants()) do
            if obj:IsA("Model") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                if hum and hrp then
                    local isLocal = (obj == LP.Character)
                    print(string.format("  %s | hp=%d | pos=(%.1f,%.1f,%.1f) | local=%s | path=%s",
                        obj.Name, math.floor(hum.Health),
                        hrp.Position.X, hrp.Position.Y, hrp.Position.Z,
                        tostring(isLocal), obj:GetFullName()))
                    found = found + 1
                end
            end
        end
        if found == 0 then print("  (нет)") end
    end
end)

-- 3. Игрок (раз в 5 сек)
task.spawn(function()
    while task.wait(5) do
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                print(string.format("[P] %s | hp=%d | pos=(%d,%d,%d)",
                    tostring(hum:GetState()), math.floor(hum.Health),
                    math.floor(hrp.Position.X), math.floor(hrp.Position.Y), math.floor(hrp.Position.Z)))
            end
        end
    end
end)

