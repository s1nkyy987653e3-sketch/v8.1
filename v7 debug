-- R1 FARM DEBUG v8.1 (внутренний watcher через getgenv)
local SCRIPT_URL = "https://raw.githubusercontent.com/s1nkyy987653e3-sketch/v8.1/refs/heads/main/v7%20debug"

-- ============================================================
-- СТОРОЖ (работает в фоне, выживает при телепорте)
-- ============================================================
if not getgenv()._R1_WATCHER_ACTIVE then
    getgenv()._R1_WATCHER_ACTIVE = true
    
    task.spawn(function()
        while true do
            task.wait(3)
            local hb = getgenv()._R1_HEARTBEAT or 0
            -- Если heartbeat не обновлялся 8 секунд — скрипт умер, перезапускаем
            if tick() - hb > 8 then
                print("[WATCHER] Скрипт завис или умер. Перезапуск через loadstring...")
                getgenv()._R1_HEARTBEAT = tick() -- сбрасываем, чтобы не спамило
                task.spawn(function()
                    local ok, err = pcall(function()
                        loadstring(game:HttpGet(SCRIPT_URL))()
                    end)
                    if not ok then print("[WATCHER] Ошибка перезапуска: " .. tostring(err)) end
                end)
            end
        end
    end)
end

-- ============================================================
-- ОСНОВНОЙ КОД
-- ============================================================
local P = game:GetService("Players")
local W = game:GetService("Workspace")
local LP = P.LocalPlayer
local RS = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

print("=== [v8.1] Запущен | " .. os.date("%H:%M:%S") .. " ===")

-- Обновляем heartbeat каждый кадр (показываем сторожу, что мы живы)
RS.RenderStepped:Connect(function()
    getgenv()._R1_HEARTBEAT = tick()
end)

local function safePos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        local ok, pivot = pcall(function() return obj:GetPivot().Position end)
        if ok then return pivot end
    end
    return Vector3.zero
end

-- 1. Газ-стена
task.spawn(function()
    while task.wait(3) do
        local gasWall = W:FindFirstChild("TPS_GasWall")
        if gasWall then
            print("=== [GASWALL] ===")
            for _, child in ipairs(gasWall:GetChildren()) do
                local pos = safePos(child)
                print(string.format("  [GAS] %s : %s | pos: (%.1f, %.1f, %.1f)",
                    child.ClassName, child.Name, pos.X, pos.Y, pos.Z))
            end
        end
    end
end)

-- 2. Зона
task.spawn(function()
    while task.wait(3) do
        print("=== [ZONE] ===")
        local found = false
        for _, obj in ipairs(W:GetDescendants()) do
            local n = string.lower(obj.Name)
            if (string.find(n, "zone") or string.find(n, "safe") or string.find(n, "storm") or
                string.find(n, "gas") or string.find(n, "circle") or string.find(n, "ring"))
                and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder")) then
                local pos = safePos(obj)
                print(string.format("  [Z] %s : %s | pos: (%.1f, %.1f, %.1f)",
                    obj.ClassName, obj.Name, pos.X, pos.Y, pos.Z))
                found = true
            end
        end
        if not found then print("  (зоны нет)") end
    end
end)

-- 3. Игрок
task.spawn(function()
    while task.wait(1) do
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                print(string.format("=== [P] %s | hp=%d | pos=(%d,%d,%d) ===",
                    tostring(hum:GetState()), math.floor(hum.Health),
                    math.floor(hrp.Position.X), math.floor(hrp.Position.Y), math.floor(hrp.Position.Z)))
            end
        end
    end
end)

-- 4. Кнопки лобби
task.spawn(function()
    while task.wait(5) do
        local char = LP.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Position.Y < 100 then
                local pg = LP:FindFirstChild("PlayerGui")
                if pg then
                    print("=== [LOBBY] ===")
                    for _, obj in ipairs(pg:GetDescendants()) do
                        if obj:IsA("TextButton") and obj.Visible then
                            local n = string.lower(obj.Name)
                            if string.find(n, "play") or string.find(n, "solo") or string.find(n, "queue") then
                                print(string.format("  [BTN] %s | path=%s", obj.Name, obj:GetFullName()))
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- 5. Клики
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then
            local mouse = UIS:GetMouseLocation()
            for _, obj in ipairs(pg:GetDescendants()) do
                if obj:IsA("TextButton") and obj.Visible then
                    local a = obj.AbsolutePosition
                    local s = obj.AbsoluteSize
                    if mouse.X >= a.X and mouse.X <= a.X + s.X and
                       mouse.Y >= a.Y and mouse.Y <= a.Y + s.Y then
                        print(string.format("=== [CLICK] %s ===", obj.Name))
                    end
                end
            end
        end
    end
end)

print("=== v8.1 готов. Сторож активен. ===")
