-- R1 FARM BOT v20 (ESP + авто-респавн, без Font)
local SCRIPT_URL = "https://raw.githubusercontent.com/s1nkyy987653e3-sketch/v8.1/refs/heads/main/v20bot"

if getgenv()._R1_BOT then
    pcall(function()
        for _, c in ipairs(getgenv()._R1_BOT.connections or {}) do
            pcall(function() c:Disconnect() end)
        end
        for _, d in pairs(getgenv()._R1_BOT.drawings or {}) do
            pcall(function() d:Remove() end)
        end
    end)
    getgenv()._R1_BOT = nil
end
getgenv()._R1_BOT = {connections = {}, drawings = {}, lastDead = false, autoRespawn = true, lastRespawnAttempt = 0}

if queue_on_teleport then
    queue_on_teleport([[
        task.wait(6)
        loadstring(game:HttpGet("https://raw.githubusercontent.com/s1nkyy987653e3-sketch/v8.1/refs/heads/main/v20bot?v=" .. tostring(tick())))()
    ]])
end

local P = game:GetService("Players")
local W = game:GetService("Workspace")
local RS = game:GetService("RunService")
local LP = P.LocalPlayer
local CAM = W.CurrentCamera

print("=== [BOT v20] Запущен | " .. os.date("%H:%M:%S") .. " ===")

local ESP_RANGE = 5000
local ESP_COLOR = Color3.fromRGB(255, 50, 50)
local ESP_SIZE = 14

local drawings = {}
local zoneText = Drawing.new("Text")
zoneText.Visible = false
zoneText.Size = 18
zoneText.Outline = true
zoneText.Center = true

local function getTargets()
    local list = {}
    local bots = W:FindFirstChild("TPS_Bots")
    if bots then
        for _, m in ipairs(bots:GetChildren()) do
            if m:IsA("Model") then
                local hum = m:FindFirstChildOfClass("Humanoid")
                local hrp = m:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    table.insert(list, {model = m, hum = hum, hrp = hrp})
                end
            end
        end
    end
    for _, plr in ipairs(P:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    table.insert(list, {model = char, hum = hum, hrp = hrp})
                end
            end
        end
    end
    return list
end

local function worldToScreen(pos)
    local sp, onScreen = CAM:WorldToViewportPoint(pos)
    if onScreen then return Vector2.new(sp.X, sp.Y) end
    return nil
end

local function tryRespawn()
    if not getgenv()._R1_BOT.autoRespawn then return end
    local now = tick()
    if now - getgenv()._R1_BOT.lastRespawnAttempt < 2 then return end
    getgenv()._R1_BOT.lastRespawnAttempt = now
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    local death = pg:FindFirstChild("R1_DeathScreen")
    if not death then return end
    local root = death:FindFirstChild("Root")
    if not root then return end
    local playAgain = root:FindFirstChild("R1_PlayAgain")
    if not playAgain then return end
    local play = playAgain:FindFirstChild("Play")
    if not play then return end
    local btn = play:FindFirstChild("PlayAgain")
    if not btn or not btn:IsA("TextButton") then return end
    pcall(function() btn:Activate() end)
    pcall(function() btn.MouseButton1Click:Fire() end)
    print("[RESPAWN] Нажал PlayAgain")
end

RS.RenderStepped:Connect(function()
    local targets = getTargets()
    local seen = {}
    local lpChar = LP.Character
    local lpHrp = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    for _, t in ipairs(targets) do
        local hrpPos = t.hrp.Position
        local dist = lpHrp and (hrpPos - lpHrp.Position).Magnitude or 0
        if dist <= ESP_RANGE then
            local screen = worldToScreen(hrpPos + Vector3.new(0, 2.5, 0))
            if screen then
                local key = t.model
                seen[key] = true
                if not drawings[key] then
                    local txt = Drawing.new("Text")
                    txt.Size = ESP_SIZE
                    txt.Outline = true
                    txt.Center = true
                    txt.Color = ESP_COLOR
                    local ln = Drawing.new("Line")
                    ln.Thickness = 1
                    ln.Color = ESP_COLOR
                    ln.Transparency = 0.7
                    drawings[key] = {text = txt, line = ln}
                end
                local d = drawings[key]
                d.text.Position = screen
                d.text.Text = string.format("%s [%d] %dm",
                    t.model.Name, math.floor(t.hum.Health), math.floor(dist))
                d.text.Visible = true
                d.line.From = Vector2.new(CAM.ViewportSize.X / 2, CAM.ViewportSize.Y)
                d.line.To = screen
                d.line.Visible = true
            end
        end
    end
    for key, d in pairs(drawings) do
        if not seen[key] then
            d.text.Visible = false
            d.line.Visible = false
        end
    end

    if lpChar then
        local hum = lpChar:FindFirstChildOfClass("Humanoid")
        if hum then
            local isDead = (hum.Health <= 0) or (hum:GetState() == Enum.HumanoidStateType.Dead)
            if isDead ~= getgenv()._R1_BOT.lastDead then
                getgenv()._R1_BOT.lastDead = isDead
                if isDead then
                    print("[DEATH] Игрок мёртв, ждём DeathScreen для респавна")
                else
                    print("[DEATH] Игрок жив")
                end
            end
            if isDead then
                task.spawn(tryRespawn)
            end
        end
    end

    local status = "ESP: ON | Авто-респавн: " .. (getgenv()._R1_BOT.autoRespawn and "ON" or "OFF")
    zoneText.Text = status
    zoneText.Color = Color3.fromRGB(0, 255, 0)
    zoneText.Position = Vector2.new(CAM.ViewportSize.X / 2, 30)
    zoneText.Visible = true
end)

getgenv()._R1_BOT.toggleRespawn = function()
    getgenv()._R1_BOT.autoRespawn = not getgenv()._R1_BOT.autoRespawn
    print("[BOT] Авто-респавн:", getgenv()._R1_BOT.autoRespawn)
end

print("=== [BOT v20] готов ===")
print("ESP: ON | Авто-респавн: ON")
print("Переключить авто-респавн: getgenv()._R1_BOT.toggleRespawn()")
