-- 1. Глубокий разбор HW_RING, GAS_1, gas_2
task.spawn(function()
    while task.wait(5) do
        for _, name in ipairs({"HW_RING", "GAS_1", "gas_2"}) do
            local found = nil
            for _, obj in ipairs(W:GetDescendants()) do
                if obj.Name == name then found = obj; break end
            end
            if found then
                print(string.format("[GAS-OBJ] %s | %s | path=%s", name, found.ClassName, found:GetFullName()))
                local count = 0
                for _, child in ipairs(found:GetDescendants()) do
                    if child:IsA("BasePart") then
                        print(string.format("  [PART] %s | size=(%.1f,%.1f,%.1f) | pos=(%.1f,%.1f,%.1f) | trans=%.2f | cancollide=%s",
                            child.Name, child.Size.X, child.Size.Y, child.Size.Z,
                            child.Position.X, child.Position.Y, child.Position.Z,
                            child.Transparency, tostring(child.CanCollide)))
                        count = count + 1
                        if count > 15 then print("  ... (обрезано)"); break end
                    end
                end
                if count == 0 then print("  (нет BasePart)") end
            end
        end
    end
end)

-- 2. Игрок (коротко)
task.spawn(function()
    while task.wait(2) do
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp then
                print(string.format("[P] %s | hp=%d | pos=(%d,%d,%d)",
                    tostring(hum:GetState()), math.floor(hum.Health),
                    math.floor(hrp.Position.X), math.floor(hrp.Position.Y), math.floor(hrp.Position.Z)))
            end
        end
    end
end)

