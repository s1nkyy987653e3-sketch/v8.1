end
local CATCOL = {
    loot=Color3.fromRGB(255,215,0), furnace=Color3.fromRGB(255,120,0),
    bench=Color3.fromRGB(180,180,180), door=Color3.fromRGB(0,200,255),
    turret=Color3.fromRGB(255,0,0), spawn=Color3.fromRGB(0,255,255),
    drone=Color3.fromRGB(255,80,200),
}

RunService.RenderStepped:Connect(function()
    if not Drawing_new_ok then return end
    if not CFG.EspEnabled then
        for _,b in pairs(ESP.boxes) do hideBox(b) end
        for _,s in pairs(ESP.skel) do hideSkel(s) end
        for _,t in pairs(ESP.texts) do if t then t.Visible=false end end
        for _,h in pairs(ESP.hl) do h.Enabled=false end
        for _,t in pairs(ESP.objTxt) do if t then t.Visible=false end end
        for _,h in pairs(ESP.objHL) do h.Enabled=false end
        return
    end
    local targets = H.getTargets()
    local alive = {}
    for _,r in ipairs(targets) do alive[r]=true end
    for r,b in pairs(ESP.boxes) do if not alive[r] then hideBox(b) end end
    for r,s in pairs(ESP.skel) do if not alive[r] then hideSkel(s) end end
    for r,t in pairs(ESP.texts) do if not alive[r] and t then t.Visible=false end end
    for r,h in pairs(ESP.hl) do if not alive[r] then h.Enabled=false end end

    for _,rig in ipairs(targets) do
        local head=rig:FindFirstChild("Head"); local root=rig:FindFirstChild("HumanoidRootPart")
        local hum=rig:FindFirstChildOfClass("Humanoid")
        if head and root and hum then
            local dist=(root.Position-Camera.CFrame.Position).Magnitude
            local show = dist <= CFG.EspPlayersDist
            local topP=head.Position+Vector3.new(0,0.6,0); local botP=root.Position-Vector3.new(0,2.8,0)
            local top,onT=Camera:WorldToViewportPoint(topP); local bot,onB=Camera:WorldToViewportPoint(botP)
            if not (onT and onB) then show=false end
            if show and CFG.EspFOV>0 then
                local sc=Vector2.new(top.X,top.Y)
                if (sc-UIS:GetMouseLocation()).Magnitude > CFG.EspFOV then show=false end
            end
            local vis = show and H.visible(rig, head) or false
            if CFG.EspVisibleOnly and not vis then show=false end
            if show then
                local isBotRig=H.isBot(rig)
                local col = isBotRig and CFG.ColBot or (vis and CFG.ColVisible or CFG.ColHidden)
                if CFG.EspBox then ESP.boxes[rig]=ESP.boxes[rig] or mkBox(); setBox(ESP.boxes[rig], top, bot, col) end
                if CFG.EspSkeleton then ESP.skel[rig]=ESP.skel[rig] or mkSkel(); setSkel(ESP.skel[rig], rig, col) end
                if CFG.EspName or CFG.EspHP or CFG.EspDistance then
                    local t=ESP.texts[rig] or mkText(13); ESP.texts[rig]=t
                    if t then
                        local parts={}
                        if CFG.EspName then table.insert(parts,(isBotRig and "[BOT] " or "")..H.rigName(rig)) end
                        if CFG.EspHP then table.insert(parts, string.format("HP %d", math.floor(hum.Health))) end
                        if CFG.EspDistance then table.insert(parts, math.floor(dist).."m") end
                        t.Text=table.concat(parts," | "); t.Position=Vector2.new(top.X, top.Y-18)
                        t.Color=col; t.Visible=true
                    end
                end
                local h=ESP.hl[rig] or mkHL(rig, col); ESP.hl[rig]=h
                h.FillColor=col; h.OutlineColor=col; h.Enabled=true
            else
                if ESP.boxes[rig] then hideBox(ESP.boxes[rig]) end
                if ESP.skel[rig] then hideSkel(ESP.skel[rig]) end
                if ESP.texts[rig] then ESP.texts[rig].Visible=false end
                if ESP.hl[rig] then ESP.hl[rig].Enabled=false end
            end
        end
    end

    for obj,cat in pairs(ESP.cache) do
        if not obj.Parent or not objOn(cat) then
            if ESP.objTxt[obj] then ESP.objTxt[obj].Visible=false end
            if ESP.objHL[obj] then ESP.objHL[obj].Enabled=false end
            continue
        end
        local part=obj:FindFirstChild("HitBox") or obj:FindFirstChild("Hitbox") or obj.PrimaryPart
        if not part then
            for _,c in ipairs(obj:GetChildren()) do if c:IsA("BasePart") then part=c; break end end
        end
        if part then
            local dist=(part.Position-Camera.CFrame.Position).Magnitude
            if dist <= CFG.EspObjectsDist then
                local sp,on=Camera:WorldToViewportPoint(part.Position)
                if on then
                    local t=ESP.objTxt[obj] or mkText(12); ESP.objTxt[obj]=t
                    if t then
                        t.Text=obj.Name.." ["..math.floor(dist).."m]"
                        t.Position=Vector2.new(sp.X,sp.Y); t.Color=CATCOL[cat] or Color3.new(1,1,1); t.Visible=true
                    end
                    local h=ESP.objHL[obj] or mkHL(obj, CATCOL[cat] or Color3.new(1,1,1)); ESP.objHL[obj]=h
                    h.FillColor=CATCOL[cat] or Color3.new(1,1,1)
                    h.OutlineColor=CATCOL[cat] or Color3.new(1,1,1); h.Enabled=true
                else
                    if ESP.objTxt[obj] then ESP.objTxt[obj].Visible=false end
                    if ESP.objHL[obj] then ESP.objHL[obj].Enabled=false end
                end
            else
                if ESP.objTxt[obj] then ESP.objTxt[obj].Visible=false end
                if ESP.objHL[obj] then ESP.objHL[obj].Enabled=false end
            end
        end
    end
end)

