--  ★ ФИКС FREECAM (Часть A)
--=====================================================================
local freecam = {
    active   = false,
    savedCF  = nil,
    savedType= nil,
    savedSub = nil,
    cf       = CFrame.new(),
    yaw      = 0,
    pitch    = 0,
}

local function startFreecam()
    local cam = Workspace.CurrentCamera
    if not cam or not cam.Parent then return end
    -- ФИКС FREECAM: сохраняем состояние
    freecam.savedCF   = cam.CFrame
    freecam.savedType = cam.CameraType
    freecam.savedSub  = cam.CameraSubject
    freecam.cf        = cam.CFrame
    -- yaw/pitch из текущего CFrame
    local look = cam.CFrame.LookVector
    freecam.yaw   = math.atan2(-look.X, -look.Z)
    freecam.pitch = math.asin(math.clamp(look.Y, -1, 1))
    -- ФИКС FREECAM: делаем Scriptable в pcall (некоторые игры блокируют)
    local ok = pcall(function() cam.CameraType = Enum.CameraType.Scriptable end)
    if not ok then
        warn("[Freecam] не удалось установить CameraType.Scriptable")
        return
    end
    freecam.active = true
    Notify("Freecam", "", true)
end

local function stopFreecam()
    local cam = Workspace.CurrentCamera
    freecam.active = false
    if not cam then return end
    pcall(function()
        if freecam.savedType   then cam.CameraType    = freecam.savedType   end
        if freecam.savedSub    then cam.CameraSubject = freecam.savedSub    end
        if freecam.savedCF     then cam.CFrame        = freecam.savedCF     end
    end)
    Notify("Freecam", "", false)
end

-- ФИКС FREECAM: BindToRenderStep с приоритетом Camera+1
local function freecamStep(dt)
    if not freecam.active then return end
    local cam = Workspace.CurrentCamera
    if not cam or not cam.Parent then return end
    -- скорость + Shift
    local sp = CFG.FreecamSpeed * dt * 50
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then sp = sp * 3 end
    local mv = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then mv += Vector3.new(0,0,-1) end
    if UIS:IsKeyDown(Enum.KeyCode.S) then mv += Vector3.new(0,0,1) end
    if UIS:IsKeyDown(Enum.KeyCode.A) then mv += Vector3.new(-1,0,0) end
    if UIS:IsKeyDown(Enum.KeyCode.D) then mv += Vector3.new(1,0,0) end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then mv -= Vector3.new(0,1,0) end
    -- ФИКС FREECAM: движение через LookVector/RightVector (не залипает)
    local look  = CFrame.fromEulerAnglesYXZ(freecam.pitch, freecam.yaw, 0)
    local right = look.RightVector
    local fwd   = look.LookVector
    local moveWorld = (fwd * -mv.Z) + (right * mv.X) + Vector3.new(0, mv.Y, 0)
    freecam.cf = freecam.cf + moveWorld * sp
    -- ФИКС FREECAM: мышь через GetMouseDelta
    local md = UIS:GetMouseDelta()
    freecam.yaw   = freecam.yaw   - md.X * 0.005
    freecam.pitch = math.clamp(freecam.pitch - md.Y * 0.005, math.rad(-89), math.rad(89))
    local newCF = CFrame.new(freecam.cf.Position) * CFrame.fromEulerAnglesYXZ(freecam.pitch, freecam.yaw, 0)
    freecam.cf = newCF
    cam.CFrame = newCF
end
pcall(function()
    RunService:BindToRenderStep("RV_Freecam", Enum.RenderPriority.Camera.Value + 1, freecamStep)
end)

--=====================================================================
--  ★ ПРЕДИКТ (Часть C)
--=====================================================================
local predictHistory = {}   -- [rig] = { samples = {...}, last = pos }

local function getVelocityOfTarget(rig)
    -- приоритет: AssemblyLinearVelocity из HRP
    local root = rig:FindFirstChild("HumanoidRootPart")
    if root and root.AssemblyLinearVelocity then
        return root.AssemblyLinearVelocity
    end
    -- fallback: history
    local hist = predictHistory[rig]
    if hist and #hist.samples >= 2 then
        local first = hist.samples[1]
        local last  = hist.samples[#hist.samples]
        local dt = last.t - first.t
        if dt > 0.01 then
            return (last.pos - first.pos) / dt
        end
    end
    return Vector3.zero
end

local function pushHistory(rig, pos)
    local h = predictHistory[rig]
    if not h then h = { samples = {} }; predictHistory[rig] = h end
    table.insert(h.samples, { t = os.clock(), pos = pos })
    -- держим ~10 сэмплов
    while #h.samples > 10 do table.remove(h.samples, 1) end
end

local function getPing()
    local ok, val = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    if ok and type(val) == "number" then return val end
    return 0
end

local function predictPosition(rig, currentPos)
    -- ★ ПРЕДИКТ
    if CFG.AimPrediction <= 0 and CFG.AimPingComp <= 0 then return currentPos end
    local vel = getVelocityOfTarget(rig)
    -- если стоит — не дёргаем
    if vel.Magnitude < 3 then return currentPos end
    local lead = getPing() + CFG.AimPrediction + CFG.AimPingComp
    return currentPos + vel * lead
end

--=====================================================================
--  ★ АИМБОТ ТОЛЬКО ПО КНОПКЕ (Часть B)
--=====================================================================
local Aim = { lastTrigger = 0, lastShot = 0, aimbotLocked = false }

-- ФИКС АИМБОТ-КНОПКА: aiming = ПКМ или бинд
local function isAiming()
    if CFG.AimMouseOnly then
        return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            or (CFG.AimBind and UIS:IsKeyDown(CFG.AimBind))
    else
        return CFG.AimBind and UIS:IsKeyDown(CFG.AimBind) or false
    end
end

local function getAimTarget()
    local mouse = UIS:GetMouseLocation()
    local best, bestScore = nil, math.huge
    for _, rig in ipairs(H.getTargets()) do
        if not H.isAlive(rig) then continue end
        local aimPos = getAimPointPos(rig)
        if not aimPos then continue end
        -- обновляем историю + предикт
        pushHistory(rig, aimPos)
        local predictedPos = predictPosition(rig, aimPos)
        local dist = (predictedPos - Camera.CFrame.Position).Magnitude
        if dist > CFG.AimDist then continue end
        if CFG.AimVisibleOnly then
            local part = getAimPointPart(rig)
            if not H.visible(rig, part) then continue end
        end
        local sp, on = Camera:WorldToViewportPoint(predictedPos)
        if not on then continue end
        local fovD = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
        if fovD > CFG.AimFOV then continue end
        if fovD < bestScore then
            bestScore = fovD
            best = { rig = rig, pos = predictedPos, rawPos = aimPos }
        end
    end
    return best
end

-- Проверка lock по углу
local function updateLock(t)
    if not t then Aim.aimbotLocked = false; return end
    local camDir   = Camera.CFrame.LookVector
    local toTarget = (t.pos - Camera.CFrame.Position).Unit
    local angle    = math.deg(math.acos(math.clamp(camDir:Dot(toTarget), -1, 1)))
    Aim.aimbotLocked = angle <= CFG.AimLockAngle
end

-- Основной цикл аимбота
RunService.RenderStepped:Connect(function()
    -- ФИКС АИМБОТ-КНОПКА: не наводимся, если:
    if not CFG.AimEnabled then Aim.aimbotLocked = false; return end
    if freecam.active then Aim.aimbotLocked = false; return end
    if not isAiming() then Aim.aimbotLocked = false; return end
    local cam = Workspace.CurrentCamera
    if not cam or not cam.Parent then return end

    local t = getAimTarget()
    updateLock(t)
    if not t then return end

    local targetCF = CFrame.new(Camera.CFrame.Position, t.pos)
    if CFG.AimSmooth <= 0 then
        Camera.CFrame = targetCF
    else
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(1 - CFG.AimSmooth, 0, 1))
    end
end)

