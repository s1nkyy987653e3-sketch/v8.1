local H = {}
H.isBot = function(rig)
    if not rig or not rig:IsA("Model") then return false end
    if not rig:FindFirstChildOfClass("Humanoid") then return false end
    return Players:GetPlayerFromCharacter(rig) == nil
end
H.isAlive = function(rig)
    local hum = rig and rig:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end
H.rigName = function(rig)
    local p = Players:GetPlayerFromCharacter(rig)
    if p then return p.DisplayName or p.Name end
    if H.isBot(rig) then return "BOT" end
    return rig.Name
end
H.isEnemy = function(rig)
    if rig == LP.Character then return false end
    if not CFG.AimTeamCheck then return true end
    local p = Players:GetPlayerFromCharacter(rig)
    if p and LP.Team and p.Team == LP.Team then return false end
    return true
end
H.visible = function(rig, part)
    if not part then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character, rig }
    local res = Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    return res == nil
end
H.getTargets = function()
    local list = {}
    if CFG.EspPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and H.isAlive(p.Character) and H.isEnemy(p.Character) then
                table.insert(list, p.Character)
            end
        end
    end
    if CFG.EspBots then
        for _, o in ipairs(Workspace:GetChildren()) do
            if o:IsA("Model") and H.isAlive(o) and H.isBot(o) and H.isEnemy(o) then
                table.insert(list, o)
            end
        end
    end
    return list
end

local function getAimPointPart(rig)
    local tool = rig:FindFirstChildOfClass("Tool")
    if tool then
        for _, d in ipairs(tool:GetDescendants()) do
            if (d:IsA("Attachment") or d:IsA("BasePart")) and d.Name == "AimPoint" then
                return d
            end
        end
    end
    return rig:FindFirstChild("Head")
end
local function getAimPointPos(rig)
    local part = getAimPointPart(rig)
    if not part then return nil end
    if part:IsA("Attachment") then return part.WorldPosition else return part.Position end
end

