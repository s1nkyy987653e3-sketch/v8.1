local ESP = { boxes={}, skel={}, texts={}, hl={}, objHL={}, objTxt={}, cache={} }
local BONES = {
    {"Head","Torso"},{"Torso","HumanoidRootPart"},
    {"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},
}
local function mkBox()
    local b = {}
    for _, k in ipairs({"top","bottom","left","right"}) do
        local l = D_new("Line")
        if l then l.Thickness=1; l.Transparency=1; l.Visible=false; b[k]=l end
    end
    return b
end
local function setBox(b, top, bot, col)
    if not b.top then return end
    b.top.From=Vector2.new(top.X,top.Y); b.top.To=Vector2.new(bot.X,top.Y)
    b.bottom.From=Vector2.new(top.X,bot.Y); b.bottom.To=Vector2.new(bot.X,bot.Y)
    b.left.From=Vector2.new(top.X,top.Y); b.left.To=Vector2.new(top.X,bot.Y)
    b.right.From=Vector2.new(bot.X,top.Y); b.right.To=Vector2.new(bot.X,bot.Y)
    for _,l in pairs(b) do l.Color=col; l.Visible=true end
end
local function hideBox(b) for _,l in pairs(b) do l.Visible=false end end
local function mkSkel()
    local s={}
    for i=1,#BONES do local l=D_new("Line"); if l then l.Thickness=1; l.Transparency=1; l.Visible=false; s[i]=l end end
    return s
end
local function setSkel(s, rig, col)
    for i,p in ipairs(BONES) do
        local a=rig:FindFirstChild(p[1]); local b=rig:FindFirstChild(p[2])
        if a and b and s[i] then
            local pa=Camera:WorldToViewportPoint(a.Position); local pb=Camera:WorldToViewportPoint(b.Position)
            s[i].From=Vector2.new(pa.X,pa.Y); s[i].To=Vector2.new(pb.X,pb.Y)
            s[i].Color=col; s[i].Visible=true
        elseif s[i] then s[i].Visible=false end
    end
end
local function hideSkel(s) for _,l in ipairs(s) do if l then l.Visible=false end end end
local function mkText(sz)
    local t=D_new("Text"); if not t then return nil end
    t.Size=sz or 13; t.Center=true; t.Outline=true
    t.OutlineColor=Color3.new(0,0,0); t.Font=2; t.Visible=false
    return t
end
local function mkHL(obj,col)
    local h=Instance.new("Highlight")
    h.Name="RV_HL"; h.FillColor=col; h.FillTransparency=0.7
    h.OutlineColor=col; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee=obj; h.Parent=obj
    return h
end
