openMenu = function()
    menuOpen = true; menu.Visible = true
    menu.Size = UDim2.new(0,0,0,0)
    TweenSvc:Create(menu, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,1000,0,560)
    }):Play()
end
closeMenu = function()
    menuOpen = false
    local t = TweenSvc:Create(menu, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0,0,0,0)
    })
    t:Play(); t.Completed:Connect(function() menu.Visible = false end)
end
closeBtn.MouseButton1Click:Connect(closeMenu)

--=====================================================================
--  UNLOAD
--=====================================================================
_G.RV_UNLOAD = function()
    for _,b in pairs(ESP.boxes) do for _,l in pairs(b) do D_remove(l) end end
    for _,s in pairs(ESP.skel) do for _,l in ipairs(s) do D_remove(l) end end
    for _,t in pairs(ESP.texts) do D_remove(t) end
    for _,t in pairs(ESP.objTxt) do D_remove(t) end
    for _,h in pairs(ESP.hl) do pcall(function() h:Destroy() end) end
    for _,h in pairs(ESP.objHL) do pcall(function() h:Destroy() end) end
    for _,h in ipairs(xrayHLs) do pcall(function() h:Destroy() end) end
    if fovCircle then D_remove(fovCircle) end
    pcall(function() notifGui:Destroy() end)
    pcall(function() invGui:Destroy() end)
    pcall(function() menuGui:Destroy() end)
    setNoclip(false)
    if freecam.active then stopFreecam() end
    pcall(function() RunService:UnbindFromRenderStep("RV_Freecam") end)
    saveConfig()
    _G.RV_LOADED = false
    print("[RivalVisuals] unloaded")
end

