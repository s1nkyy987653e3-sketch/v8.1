--  ★ АВТОШОТ (Часть D)
--=====================================================================
local shotErrorLogged = false
local function tryShoot()
    local tool = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
    -- 1) Activate
    if tool and type(tool.Activate) == "function" then
        local ok = pcall(function() tool:Activate() end)
        if ok then return true end
    end
    -- 2) VIM как fallback
    local ok = pcall(function()
        local mp = UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(mp.X, mp.Y, 0, true, game, 0)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(mp.X, mp.Y, 0, false, game, 0)
    end)
    if not ok and not shotErrorLogged then
        shotErrorLogged = true
        warn("[AutoShoot] не удалось выстрелить ни одним способом")
    end
    return ok
end

RunService.RenderStepped:Connect(function()
    -- ★ АВТОШОТ: все условия
    if not CFG.AutoShootEnabled then return end
    if not CFG.AimEnabled then return end
    if freecam.active then return end
    if not isAiming() then return end
    if not Aim.aimbotLocked then return end
    if tick() - Aim.lastShot < CFG.AutoShootDelay then return end
    Aim.lastShot = tick()
    safeCall(tryShoot)
end)

