local function objOn(cat)
    if not CFG.ObjEnabled then return false end
    if cat=="loot" then return CFG.ObjLoot end
    if cat=="furnace" then return CFG.ObjFurnace end
    if cat=="bench" then return CFG.ObjBench end
    if cat=="door" then return CFG.ObjDoor end
    if cat=="turret" then return CFG.ObjTurret end
    if cat=="spawn" then return CFG.ObjSpawn end
    if cat=="drone" then return CFG.ObjDrone end
