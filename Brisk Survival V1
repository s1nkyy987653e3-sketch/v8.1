--=====================================================================
--  Безопасная сериализация (ФИКС БАГА #1)
--=====================================================================
local function serializeValue(v)
    if typeof(v) == "EnumItem" then
        if v.EnumType == Enum.KeyCode then return {__kc = v.Name} end
        return {__enum = v.EnumType.Name, name = v.Name}
    elseif typeof(v) == "Color3" then
        return {__color = true, r = v.R, g = v.G, b = v.B}
    elseif type(v) == "string" or type(v) == "number" or type(v) == "boolean" then
        return v
    elseif type(v) == "table" then
        local out = {}
        for kk, vv in pairs(v) do
            if kk ~= "Name" and kk ~= "Value" and kk ~= "EnumType" then
                out[kk] = serializeValue(vv)
            end
        end
        return out
    end
    return nil
end
local function deserializeValue(v)
    if type(v) == "table" then
        if v.__kc then
            local ok, kc = pcall(function() return Enum.KeyCode[v.__kc] end)
            if ok and kc then return kc end
            return nil
        elseif v.__enum then
            local ok, e = pcall(function() return Enum[v.__enum][v.name] end)
            return ok and e or nil
        elseif v.__color then
            return Color3.new(v.r, v.g, v.b)
        else
            local out = {}
            for kk, vv in pairs(v) do out[kk] = deserializeValue(vv) end
            return out
        end
    end
    return v
end

local saveQueued, saveErrorLogged = false, false
local function saveConfig()
    local ok, err = pcall(function()
        local copy = {}
        for k, v in pairs(CFG) do copy[k] = serializeValue(v) end
        local data = HttpSvc:JSONEncode(copy)
        if hasFS then pcall(writefile, CONFIG_PATH, data) end
        _G.RV_CFG = data
    end)
    if not ok and not saveErrorLogged then
        saveErrorLogged = true
        warn("[RivalVisuals] saveConfig error:", err)
    end
end
local function queueSave()
    if saveQueued then return end
    saveQueued = true
    task.delay(0.6, function() saveQueued = false; saveConfig() end)
end
local function loadConfig()
    local raw
    if hasFS and isfile(CONFIG_PATH) then
        local ok, d = pcall(readfile, CONFIG_PATH); if ok then raw = d end
    end
    if not raw then raw = _G.RV_CFG end
    if not raw then return end
    local ok, t = pcall(HttpSvc.JSONDecode, HttpSvc, raw)
    if not ok or type(t) ~= "table" then return end
    for k, v in pairs(t) do
        if DEFAULT[k] ~= nil then
            local d = deserializeValue(v)
            if d ~= nil then CFG[k] = d end
        end
    end
end
loadConfig()

