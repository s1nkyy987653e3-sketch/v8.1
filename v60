local function getMatch()
    local tps = RStorage:FindFirstChild("TPS")
    if not tps then return nil end
    local remotes = tps:FindFirstChild("Remotes")
    if not remotes then return nil end
    return remotes:FindFirstChild("Match")
end
local function getMenu()
    local r1 = RStorage:FindFirstChild("R1Remotes")
    if not r1 then return nil end
    return r1:FindFirstChild("Menu")
end

local function isInMainMenu()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return false end
    local r1menu = pg:FindFirstChild("R1_Menu")
    if not r1menu then return false end
    if r1menu.Enabled == false then return false end
    local store = r1menu:FindFirstChild("Store", true)
    if store and store:IsA("GuiObject") and store.Visible then return true end
    local battlePass = r1menu:FindFirstChild("Battle Pass", true)
    if battlePass and battlePass:IsA("GuiObject") and battlePass.Visible then return true end
    local crates = r1menu:FindFirstChild("Crates", true)
    if crates and crates:IsA("GuiObject") and crates.Visible then return true end
    return false
end

-- ================= ТИП ОРУЖИЯ =================
local function getWeaponTypeFromName(name)
    local n = string.lower(name)
    if string.find(n, "ak") or string.find(n, "akmesh") then return "AK47" end
    if string.find(n, "sniper") or string.find(n, "awp") or string.find(n, "lenses") or string.find(n, "bolt") then return "Sniper" end
    if string.find(n, "m4") or string.find(n, "carbine") then return "M4" end
    if string.find(n, "shotgun") or string.find(n, "pump") then return "Shotgun" end
    if string.find(n, "pistol") or string.find(n, "glock") or string.find(n, "deagle") then return "Pistol" end
    if string.find(n, "ammo") or string.find(n, "mag") or string.find(n, "bullet") or string.find(n, "round") then return "Ammo" end
    if string.find(n, "med") or string.find(n, "health") or string.find(n, "heal") or string.find(n, "bandage") then return "Med" end
    if string.find(n, "armor") or string.find(n, "vest") then return "Armor" end
    return nil
end

local function getHeldWeaponType()
    local char = LP.Character
    if not char then return nil end
    local held = char:FindFirstChild("TPS_HeldWeapon")
    if not held then return nil end
    for _, obj in ipairs(held:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("UnionOperation") then
            local t = getWeaponTypeFromName(obj.Name)
            if t and t ~= "Ammo" and t ~= "Med" and t ~= "Armor" then return t end
        end
    end
    return nil
end

local function getBackpackItems()
    local backpack = LP:FindFirstChild("Backpack")
    if not backpack then return {} end
    local items = {}
    for _, obj in ipairs(backpack:GetChildren()) do
        if obj:IsA("Tool") or obj:IsA("Model") then
            local t = getWeaponTypeFromName(obj.Name)
            if t then items[t] = (items[t] or 0) + 1 end
        end
    end
    return items
end

local function getInventory()
    local inv = {}
    local held = getHeldWeaponType()
    if held then inv[held] = (inv[held] or 0) + 1 end
    local bp = getBackpackItems()
    for k, v in pairs(bp) do inv[k] = (inv[k] or 0) + v end
    return inv
end

local function getWeaponCount(inventory)
    local count = 0
    for _, t in ipairs({"AK47", "Sniper", "M4", "Shotgun", "Pistol"}) do
        if inventory[t] and inventory[t] > 0 then count = count + inventory[t] end
    end
    return count
end

local function shouldLoot(item, inventory)
    local t = getWeaponTypeFromName(item.model.Name)
    if not t then return true end
    if t == "AK47" or t == "Sniper" or t == "M4" or t == "Shotgun" or t == "Pistol" then
        if inventory[t] and inventory[t] > 0 then return false end
        return true
    end
    if t == "Ammo" then
        local weaponCount = getWeaponCount(inventory)
        if weaponCount == 0 then return false end
        local maxAmmo = weaponCount * getgenv()._R1_BOT.maxAmmoPerWeapon
        if (inventory["Ammo"] or 0) >= maxAmmo then return false end
        return true
    end
    if t == "Med" or t == "Armor" then
        if inventory[t] and inventory[t] >= 3 then return false end
        return true
    end
    return true
end

-- ================= ЛУТ =================
local function getLootItems()
    local items = {}
    local function scan(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("Part") then
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Handle") or (obj:IsA("BasePart") and obj) or obj:FindFirstChildWhichIsA("BasePart")
                    if root then table.insert(items, {model = obj, prompt = prompt, pos = root.Position}) end
                end
            end
            if obj:IsA("Folder") or obj:IsA("Model") then
                if not obj:FindFirstChildOfClass("Humanoid") then scan(obj) end
            end
        end
    end
    scan(W)
    return items
end

local function worldToScreen(pos)
    local sp, onScreen = CAM:WorldToViewportPoint(pos)
    if onScreen then return Vector2.new(sp.X, sp.Y) end
    return nil
end

-- ФИКС: pickupLoot с fireproximityprompt или InputHoldBegin/End
local function pickupLoot(prompt)
    if not prompt then return false end
    local ok = pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(0.1)
            prompt:InputHoldEnd()
        end
    end)
    return ok
end

local function tryLoot(lpChar, lpHrp, targets)
    if not getgenv()._R1_BOT.autoLoot then return end
    if not getMatch() then return end
    if isInMainMenu() then return end
    local hum = lpChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.Health <= 0 then return end
    local now = tick()
    if now - getgenv()._R1_BOT.lastLoot < 0.5 then return end
    getgenv()._R1_BOT.lastLoot = now

    local inventory = getInventory()
    local current = getgenv()._R1_BOT.currentLoot
    if current and current.model and current.model.Parent then
        if not shouldLoot(current, inventory) then
            getgenv()._R1_BOT.currentLoot = nil
        else
            local dist = (current.pos - lpHrp.Position).Magnitude
            if dist <= getgenv()._R1_BOT.lootPickupDist then
                pickupLoot(current.prompt)
                getgenv()._R1_BOT.currentLoot = nil
                return
            elseif dist <= getgenv()._R1_BOT.lootRadius then
                hum:MoveTo(current.pos)
                return
            else
                getgenv()._R1_BOT.currentLoot = nil
            end
        end
    end

    local items = getLootItems()
    local nearest = nil
    local nearestDist = math.huge
    for _, item in ipairs(items) do
        if shouldLoot(item, inventory) then
            local d = (item.pos - lpHrp.Position).Magnitude
            if d < nearestDist and d <= getgenv()._R1_BOT.lootRadius then
                nearestDist = d
                nearest = item
            end
        end
    end
    if nearest then
        getgenv()._R1_BOT.currentLoot = nearest
        hum:MoveTo(nearest.pos)
        local t = getWeaponTypeFromName(nearest.model.Name) or "?"
        local ammoInfo = ""
        if t == "Ammo" then
            local wc = getWeaponCount(inventory)
            ammoInfo = string.format(" [патроны: %d/%d]", inventory["Ammo"] or 0, wc * getgenv()._R1_BOT.maxAmmoPerWeapon)
        end
        print(string.format("[LOOT] Иду к %s (%s) (%.0f м)%s", nearest.model.Name, t, nearestDist, ammoInfo))
    end
end

local function sendMenu()
    local match = getMatch()
    if not match then return false end
    if not match:IsA("RemoteEvent") then return false end
    if not getgenv()._R1_BOT.autoFarm then return false end
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.Health > 0 then return false end
    local now = tick()
    if now - getgenv()._R1_BOT.lastMenuSent < 2 then return false end
    getgenv()._R1_BOT.lastMenuSent = now
    local ok, err = pcall(function() match:FireServer("Menu") end)
    if ok then
        print("[FARM] Match:FireServer('Menu') — PlayAgain (hp=0)")
        return true
    else
        print("[FARM] Ошибка:", err)
        return false
    end
end

local function sendQueue()
    local menu = getMenu()
    if not menu then return false end
    if not menu:IsA("RemoteFunction") then return false end
    if not getgenv()._R1_BOT.autoStart then return false end
    if not isInMainMenu() then return false end
    local now = tick()
    if now - getgenv()._R1_BOT.lastStart < 5 then return false end
    getgenv()._R1_BOT.lastStart = now
    local ok, res = pcall(function() return menu:InvokeServer("Queue", "Solo") end)
    if ok then
        print("[START] Menu:InvokeServer('Queue', 'Solo')")
        return true
    else
        print("[START] Ошибка:", res)
        return false
    end
end

local function tryEvade(lpChar, lpHrp, targets)
    if not getgenv()._R1_BOT.evade then return end
    if not getMatch() then return end
    if isInMainMenu() then return end
    local hum = lpChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.Health <= 0 then return end
    local nearest = nil
    local nearestDist = math.huge
    for _, t in ipairs(targets) do
        local d = (t.hrp.Position - lpHrp.Position).Magnitude
        if d < nearestDist then nearestDist = d; nearest = t end
    end
    if not nearest or nearestDist > EVADE_RANGE or nearestDist < 5 then return end
    local now = tick()
    if now - getgenv()._R1_BOT.lastEvade < 0.5 then return end
    getgenv()._R1_BOT.lastEvade = now
    local dir = (lpHrp.Position - nearest.hrp.Position)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.1 then dir = Vector3.new(math.random(-1,1), 0, math.random(-1,1)) end
    dir = dir.Unit
    hum:MoveTo(lpHrp.Position + dir * 50)
    print(string.format("[EVADE] Бегу от %s (%.0f м)", nearest.model.Name, nearestDist))
end

-- ================= ОСНОВНОЙ ЦИКЛ =================
RS.RenderStepped:Connect(function()
    local targets = getTargets()
    local seen = {}
    local lpChar = LP.Character
    local lpHrp = lpChar and lpChar:FindFirstChild("HumanoidRootPart")
    local nearestDist = math.huge
    for _, t in ipairs(targets) do
        local hrpPos = t.hrp.Position
        local dist = lpHrp and (hrpPos - lpHrp.Position).Magnitude or 0
        if dist < nearestDist then nearestDist = dist end
        if dist <= ESP_RANGE then
            local screen = worldToScreen(hrpPos + Vector3.new(0, 2.5, 0))
            if screen then
                local key = t.model
                seen[key] = true
                local isDanger = dist <= DANGER_RANGE
                local isEvade = dist <= EVADE_RANGE
                if not drawings[key] then
                    local txt = Drawing.new("Text")
                    txt.Size = ESP_SIZE
                    txt.Outline = true
                    txt.Center = true
                    local ln = Drawing.new("Line")
                    ln.Thickness = 1
                    ln.Transparency = 0.7
                    drawings[key] = {text = txt, line = ln}
                end
                local d = drawings[key]
                d.text.Position = screen
                d.text.Text = string.format("%s [%d] %dm%s",
                    t.model.Name, math.floor(t.hum.Health), math.floor(dist),
                    isDanger and " ⚠" or (isEvade and " ⚡" or ""))
                d.text.Color = isDanger and DANGER_COLOR or (isEvade and EVADE_COLOR or ESP_COLOR)
                d.text.Visible = true
                d.line.From = Vector2.new(CAM.ViewportSize.X / 2, CAM.ViewportSize.Y)
                d.line.To = screen
                d.line.Color = isDanger and DANGER_COLOR or (isEvade and EVADE_COLOR or ESP_COLOR)
                d.line.Visible = true
            end
        end
    end
    for key, d in pairs(drawings) do
        if not seen[key] then
            d.text.Visible = false
            d.line.Visible = false
        end
    end

    if lpChar then
        local hum = lpChar:FindFirstChildOfClass("Humanoid")
        if hum then
            local isDead = (hum.Health <= 0) or (hum:GetState() == Enum.HumanoidStateType.Dead)
            if isDead ~= getgenv()._R1_BOT.lastDead then
                getgenv()._R1_BOT.lastDead = isDead
                if isDead then
                    print("[DEATH] Игрок мёртв (hp=0) — PlayAgain через 1 сек")
                    getgenv()._R1_BOT.currentLoot = nil
                    task.spawn(function()
                        task.wait(1)
                        sendMenu()
                    end)
                else
                    print("[DEATH] Игрок жив")
                end
            end
            if not isDead then
                local pg = LP:FindFirstChild("PlayerGui")
                local death = pg and pg:FindFirstChild("R1_DeathScreen")
                if death and death.Enabled then sendMenu() end
                if lpHrp then
                    local nearestEnemy = nil
                    local nearestEnemyDist = math.huge
                    for _, t in ipairs(targets) do
                        local d = (t.hrp.Position - lpHrp.Position).Magnitude
                        if d < nearestEnemyDist then nearestEnemyDist = d; nearestEnemy = t end
                    end
                    if nearestEnemy and nearestEnemyDist <= EVADE_RANGE then
                        tryEvade(lpChar, lpHrp, targets)
                    else
                        tryLoot(lpChar, lpHrp, targets)
                    end
                end
                if isInMainMenu() then sendQueue() end
            end
        end
    end

    local inv = getInventory()
    local invStr = ""
    for k, v in pairs(inv) do invStr = invStr .. k .. "=" .. v .. " " end
    local status = string.format("ESP: ON | Фарм: %s | Уклонение: %s | Лут: %s | hp: %d | Ближайший: %s | %s",
        getgenv()._R1_BOT.autoFarm and "ON" or "OFF",
        getgenv()._R1_BOT.evade and "ON" or "OFF",
        getgenv()._R1_BOT.autoLoot and "ON" or "OFF",
        lpChar and lpChar:FindFirstChildOfClass("Humanoid") and math.floor(lpChar:FindFirstChildOfClass("Humanoid").Health) or 0,
        nearestDist < math.huge and string.format("%dm", math.floor(nearestDist)) or "-",
        invStr)
    statusText.Text = status
    statusText.Color = isInMainMenu() and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(0, 200, 255)
    statusText.Position = Vector2.new(CAM.ViewportSize.X / 2, 30)
    statusText.Visible = true
end)

